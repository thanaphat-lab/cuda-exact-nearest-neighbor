{
  "schema_version": 3,
  "initial_state": "intake",
  "terminal_states": ["ready_for_owner", "complete", "blocked"],
  "states": ["intake", "working", "validated", "review_required", "ready_for_owner", "complete", "blocked"],
  "roles": {
    "owner": {
      "owns": ["worktree_preparation", "git_mutations", "github_mutations", "merge_decision"]
    },
    "codex": {
      "owns": ["scoped_implementation", "build", "test", "debug_iteration", "evidence_handoff"],
      "forbidden": ["git_mutations", "github_mutations", "contract_changes_without_owner_decision", "scope_expansion_without_owner_decision"]
    },
    "chatgpt": {
      "owns": ["material_correctness_review", "material_design_review"],
      "forbidden": ["repository_edits", "git_mutations", "github_mutations"]
    }
  },
  "source_authority": {
    "material_conflict_action": "blocked",
    "responsibilities": [
      {"id":"repository_agent_instructions","responsibility":"operational_constraints_and_workflow_routing","defines_approved_project_contracts":false,"may_redefine_approved_contracts":false},
      {"id":"approved_project_specification","responsibility":"numerical_optimization_and_acceptance_contracts","defines_approved_project_contracts":true,"may_redefine_approved_contracts":false},
      {"id":"approved_design_decisions","responsibility":"implementation_choices_consistent_with_specification","defines_approved_project_contracts":false,"may_redefine_approved_contracts":false},
      {"id":"repository_configuration","responsibility":"executable_build_test_and_benchmark_mechanics","defines_approved_project_contracts":false,"may_redefine_approved_contracts":false},
      {"id":"current_user_authorization","responsibility":"task_scope_and_permission_for_non_git_local_work","defines_approved_project_contracts":false,"may_redefine_approved_contracts":false}
    ]
  },
  "development_policy": {
    "scoped_change_request_authorizes": ["repository_local_edits", "build", "test", "validation", "debug_iteration"],
    "repeat_approval_not_required_for": ["in_scope_edit", "build_retry", "test_rerun", "in_scope_failure_fix"],
    "new_owner_decision_required_for": ["scope_expansion", "canonical_contract_change", "dependency_installation", "environment_change", "destructive_action"],
    "git_and_github_mutation_actor": "owner",
    "material_review_actor": "chatgpt"
  },
  "performance_policy": {
    "requires_correctness_acceptance": true,
    "hypothesis_outcomes": ["supported", "rejected", "inconclusive"],
    "rejected_hypothesis_is_valid_experiment_outcome": true,
    "unavailable_required_hardware_status": "blocked"
  },
  "transitions": [
    {"id":"start-scoped-work","from":"intake","to":"working","actor":"codex","route":"cuda-dev-workflow","requires":["owner_prepared_worktree","scoped_change_request","applicable_contracts_resolved"],"produces":["scope_record"]},
    {"id":"iterate-in-scope","from":"working","to":"working","actor":"codex","route":"cuda-kernel-engineering","requires":["scope_record","in_scope_change_or_failure"],"produces":["updated_change_and_check_evidence"]},
    {"id":"validate-work","from":"working","to":"validated","actor":"codex","route":"verification","requires":["executed_relevant_checks","per_check_status_recorded","correctness_status_recorded"],"produces":["verification_evidence"]},
    {"id":"fix-validation-failure","from":"validated","to":"working","actor":"codex","route":"cuda-dev-workflow","condition":{"validation_outcome":"failed_fix_within_scope"},"requires":["failure_evidence","in_scope_fix_available"],"produces":["debug_iteration_record"]},
    {"id":"request-material-review","from":"validated","to":"review_required","actor":"chatgpt","route":"change-review","condition":{"material_correctness_or_design_risk":true},"requires":["verification_evidence","review_scope"],"produces":["review_findings"]},
    {"id":"address-review-findings","from":"review_required","to":"working","actor":"codex","route":"cuda-dev-workflow","condition":{"review_outcome":"changes_requested_within_scope"},"requires":["review_findings","in_scope_fix_available"],"produces":["review_fix_record"]},
    {"id":"handoff-reviewed-work","from":"review_required","to":"ready_for_owner","actor":"codex","route":"cuda-dev-workflow","condition":{"material_findings_resolved":true},"requires":["review_findings","verification_evidence","required_checks_acceptable","owner_handoff"],"produces":["completion_report"]},
    {"id":"handoff-routine-work","from":"validated","to":"ready_for_owner","actor":"codex","route":"cuda-dev-workflow","condition":{"material_correctness_or_design_risk":false},"requires":["verification_evidence","required_checks_acceptable","owner_handoff"],"produces":["completion_report"]},
    {"id":"complete-read-only-work","from":"intake","to":"complete","actor":"codex_or_chatgpt","route":"cuda-dev-workflow","requires":["read_only_scope","evidence_report"],"produces":["completion_report"]}
  ],
  "blocked_transition": {
    "from": "any_nonterminal_state",
    "to": "blocked",
    "requires_any": ["missing_or_conflicting_contract", "scope_expansion_required", "canonical_contract_change_required", "dependency_or_environment_change_required", "destructive_action_required", "required_tool_unavailable", "required_gpu_unavailable", "required_benchmark_hardware_unavailable", "external_dependency_unavailable"],
    "produces": ["blocked_report"]
  },
  "resume_rule": {"requires":["blocking_condition_rechecked","blocking_condition_resolved"],"to":"recorded_resume_state"}
}
